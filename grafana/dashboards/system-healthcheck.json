      },
      "id": 1,
      "options": {
        "content": "## Mouse Tracking System Healthcheck\n\nTracks the observable health of the heatmap pipeline: browser events -> Tracking API -> Kafka -> Spark Streaming -> PostgreSQL -> Grafana/heatmap UI. This dashboard uses the PostgreSQL datasource, so API/Kafka/Spark health is inferred from data arriving in `event_raw` and `mouse_heatmap`.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "title": "System Healthcheck",
      "type": "text"
    },
    {
      "datasource": {
        "type": "postgres",
        "uid": "postgres_mouse_tracking"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "mode": "basic",
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "OK": {
                        "color": "green",
                        "index": 0
                      },
                      "WARN": {
                        "color": "orange",
                        "index": 1
                      },
                      "NO DATA": {
                        "color": "red",
                        "index": 2
                      }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 2,
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "postgres_mouse_tracking"
          },
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH stats AS (\n  SELECT\n    COUNT(*) AS total_events,\n    COUNT(*) FILTER (WHERE event_type = 'click') AS click_events,\n    COUNT(*) FILTER (WHERE event_type = 'mousemove') AS mousemove_events,\n    COUNT(*) FILTER (WHERE event_type = 'scroll') AS scroll_events,\n    COALESCE(EXTRACT(EPOCH FROM (NOW() - MAX(ingested_at)))::int, 999999) AS latest_event_age_sec\n  FROM event_raw\n), heatmap_stats AS (\n  SELECT\n    COUNT(*) AS heatmap_buckets,\n    COALESCE(SUM(event_count), 0) AS heatmap_events,\n    COALESCE(EXTRACT(EPOCH FROM (NOW() - MAX(updated_at)))::int, 999999) AS heatmap_age_sec\n  FROM mouse_heatmap\n)\nSELECT subsystem, status, details\nFROM (\n  SELECT 1 AS sort_order, 'PostgreSQL datasource' AS subsystem, 'OK' AS status, 'Grafana query succeeded at ' || TO_CHAR(NOW(), 'YYYY-MM-DD HH24:MI:SS') AS details\n  UNION ALL\n  SELECT 2, 'Tracking API /track -> Kafka', CASE WHEN total_events > 0 THEN 'OK' ELSE 'NO DATA' END, total_events || ' events observed in event_raw' FROM stats\n  UNION ALL\n  SELECT 3, 'Kafka -> Spark -> PostgreSQL ingestion', CASE WHEN latest_event_age_sec <= 300 THEN 'OK' WHEN total_events > 0 THEN 'WARN' ELSE 'NO DATA' END, 'latest event age: ' || latest_event_age_sec || ' seconds' FROM stats\n  UNION ALL\n  SELECT 4, 'Click event coverage', CASE WHEN click_events > 0 THEN 'OK' ELSE 'NO DATA' END, click_events || ' click events' FROM stats\n  UNION ALL\n  SELECT 5, 'Mousemove event coverage', CASE WHEN mousemove_events > 0 THEN 'OK' ELSE 'NO DATA' END, mousemove_events || ' mousemove events' FROM stats\n  UNION ALL\n  SELECT 6, 'Scroll event coverage', CASE WHEN scroll_events > 0 THEN 'OK' ELSE 'NO DATA' END, scroll_events || ' scroll events' FROM stats\n  UNION ALL\n  SELECT 7, 'Spark heatmap aggregate writer', CASE WHEN heatmap_buckets > 0 THEN 'OK' ELSE 'NO DATA' END, heatmap_buckets || ' buckets, ' || heatmap_events || ' aggregated events' FROM heatmap_stats\n  UNION ALL\n  SELECT 8, 'Heatmap UI data source', CASE WHEN heatmap_buckets > 0 OR total_events > 0 THEN 'OK' ELSE 'NO DATA' END, 'heatmap API can render from event_raw and mouse_heatmap' FROM stats, heatmap_stats\n) checks\nORDER BY sort_order;",
          "refId": "A"
        }
      ],
      "title": "Subsystem Health Matrix",
      "type": "table"
    },
